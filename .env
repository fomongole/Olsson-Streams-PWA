# Olsson Streams API base URL (must end with a trailing slash).
# Primary: Render (Frankfurt). Failover: duckdns.org (same origin path).
VITE_API_BASE_URL=https://olsson-streams-api.onrender.com/api/v1/
VITE_API_FAILOVER_BASE_URL=https://olsson-streams-api.duckdns.org/api/v1/

# Feature flags (true/false). Downloads stay hidden until the download
# feature is implemented.
VITE_FEATURE_DOWNLOADS=false
VITE_FEATURE_PUSH=false
